const fs = require('fs');

const chapters = {
  'ch1': [17427992, 17486625, 17496135, 17455326, 17427998, 18206814, 17709077],
  'ch2': [17427989, 17427990, 17473174, 17427972, 17806195, 17768140],
  'ch3': [17427991, 17789433, 17427983, 17827240, 17831019, 17992467, 18201116, 17488048, 18197969, 17471660, 17825820, 17673963, 18009957, 18313002, 18448970],
  'ch4': [17427994, 17427996, 17694438, 17568434, 17573099, 18216898, 18149278, 18135420, 18098664, 17679292, 17455609, 17682189, 17463023],
  'ch5': [17489715, 18213504, 17495745],
  'ch6': [17428001, 17609079, 17609144, 18241874, 18301924, 18297451, 18111614, 18104446, 17586447, 17615133, 17611267, 18421269],
  'ch7': [17477376, 17478604, 18096444, 18045385, 18136898, 18345938, 17496086, 17646813, 18230772, 18331419, 18324342, 18050422, 17995013],
};

function extractBody(html) {
  const start = html.indexOf('cnblogs_post_body');
  if (start === -1) return null;
  const from = html.indexOf('>', start) + 1;
  const end = html.indexOf('postDesc', from);
  let body = html.slice(from, end === -1 ? html.length : end);
  body = body.replace(/\r/g, '');
  // 标题
  body = body.replace(/<h([1-6])[^>]*>\s*([\s\S]*?)\s*<\/h\1>/gi, (m, lv, t) => {
    const clean = t.replace(/<[^>]+>/g, '').trim();
    return '\n' + '#'.repeat(Math.min(+lv + 1, 6)) + ' ' + clean + '\n';
  });
  // 代码块：保留语言
  body = body.replace(/<pre><code(?: class="language-(\w+)")?>([\s\S]*?)<\/code><\/pre>/gi, (m, lang, code) => {
    const decoded = code.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&amp;/g, '&');
    return '\n```' + (lang || 'cpp') + '\n' + decoded.trimEnd() + '\n```\n';
  });
  // 行内代码
  body = body.replace(/<code>([\s\S]*?)<\/code>/gi, (m, c) => '`' + c.replace(/<[^>]+>/g, '') + '`');
  // 加粗
  body = body.replace(/<(strong|b)>([\s\S]*?)<\/\1>/gi, (m, t, c) => '**' + c.replace(/<[^>]+>/g, '') + '**');
  // 公式块（mathjax div）
  body = body.replace(/<div class="math display">\s*\\\[([\s\S]*?)\\\]\s*<\/div>/gi, (m, f) => '\n$$' + f.trim() + '$$\n');
  body = body.replace(/<span class="math inline">\s*\\\(([\s\S]*?)\\\)\s*<\/span>/gi, (m, f) => '$' + f.trim() + '$');
  // 列表
  body = body.replace(/<li>([\s\S]*?)<\/li>/gi, (m, c) => '- ' + c.replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim() + '\n');
  // 图片保留 src
  body = body.replace(/<img[^>]*src="([^"]*)"[^>]*>/gi, (m, src) => '\n[图] ' + src + '\n');
  // 段落和换行
  body = body.replace(/<br\s*\/?>/gi, '\n');
  body = body.replace(/<\/(p|div|table|tr|h[1-6]|pre)>/gi, '\n');
  body = body.replace(/<\/td>|<\/th>/gi, ' | ');
  body = body.replace(/<[^>]+>/g, '');
  // 实体
  body = body.replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '"').replace(/&#39;/g, "'").replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&');
  body = body.replace(/[ \t]+\n/g, '\n').replace(/\n{3,}/g, '\n\n');
  return body.trim();
}

for (const [ch, ids] of Object.entries(chapters)) {
  let out = '';
  for (const id of ids) {
    const html = fs.readFileSync(`notes/${id}.html`, 'utf8');
    const titleM = html.match(/cb_postTitle = '([^']*)'/);
    const title = titleM ? titleM[1] : id;
    const body = extractBody(html) || '[[正文提取失败]]';
    out += `\n\n===== ${id} | ${title} =====\nhttps://www.cnblogs.com/o-Sakurajimamai-o/p/${id}\n\n` + body + '\n';
  }
  fs.writeFileSync(`${ch}.txt`, out);
  console.log(ch, (out.length / 1024).toFixed(1) + 'KB');
}
